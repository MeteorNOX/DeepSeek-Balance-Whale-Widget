{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Desktop Whale",
  "mainBinaryName": "DS Desktop Whale",
  "version": "1.0.0",
  "identifier": "com.dsw.whale",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi"
      }
    }
  }
}
